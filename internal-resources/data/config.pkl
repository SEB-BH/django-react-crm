amends "https://pages.git.generalassemb.ly/modular-curriculum-all-courses/universal-resources-internal/static/v2/pkl/template.pkl"

import "microlessons.pkl" as mls

// After modifying this file, evaluate it to regenerate config.json.

repo {
  friendlyName = "Django + React CRM"
  name = "django-react-crm"
  type = "Lesson"
  about = "Build a staff CRM with Django REST Framework and React."
  starterCode = "./starter-code"
  solutionCode = "./solution-code"
}

courses {
  new {
    name = "fallback"
    microlessons {
      mls.projectOverview
      mls.backEndSetup
      mls.djangoApiConcepts
      mls.contactModelAndAdmin
      mls.contactApi
      mls.reactSetupAndRouting
      mls.readingContacts
      mls.creatingContacts
      mls.contactDetailsEditDelete
      mls.opportunitiesAndRelationships
      mls.salesPipeline
      mls.interactionHistory
      mls.dashboardMetrics
      mls.jwtAuthentication
      mls.finishAndExtend
    }
  }
}
